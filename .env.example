# Copy this file to .env.local and fill in your values.
# NEVER put real keys in this file — it is committed to git. Real secrets go in
# .env.local (which is gitignored).

# Every value below is a PLACEHOLDER. The server logs "[env] ✗ …" at startup
# for any required variable that's missing or still a placeholder.
#
# On Vercel, set each variable under Settings → Environment Variables and tick
# BOTH "Production" and "Preview" (unless noted). Redeploy after changing them.

# Public site URL — the auth base URL and the domain in confirm/reset email links.
#   Local:      http://localhost:3000
#   Vercel:     Production only, e.g. https://your-app.vercel.app. Leave it unset
#               for Preview — previews then use their own https://$VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Database (Neon Postgres + pgvector) — REQUIRED (Production + Preview) ---
# Neon Console → your project → Connect → enable "Connection pooling" → copy.
# Server-only. Run `npm run db:setup` once to create the tables. See NEON_SETUP.md.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Auth (Better Auth) — REQUIRED (Production + Preview) ---
# Random secret (32+ chars) that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the placeholder: anyone could forge logins with it.
BETTER_AUTH_SECRET=your_random_32_byte_secret

# --- Email (Resend) for signup confirmation + password reset ---
# REQUIRED on Vercel (Production + Preview): without it nobody can confirm an
# account or reset a password. Leave blank locally: emails print to the console.
#   RESEND_API_KEY  https://resend.com/api-keys ("Sending access" is enough).
#   EMAIL_FROM      an address on a domain you've VERIFIED in Resend → Domains
#                   (add the DNS records Resend shows, wait for "Verified").
#                   Unset falls back to onboarding@resend.dev, which can ONLY
#                   send to your own Resend account email — fine for a quick
#                   test, useless for real users.
RESEND_API_KEY=
EMAIL_FROM=PostPilot <noreply@yourdomain.com>

# --- OpenRouter (text generation) ---
# One key, many models. Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key
# Cheap defaults to keep spend low; override per task with MODEL_* vars.
# IDs: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_CHEAP=google/gemini-2.5-flash-lite
# Image model for the auto-generated post infographic (fast + cheap default;
# use google/gemini-3-pro-image for max quality but ~45s latency).
MODEL_IMAGE=google/gemini-2.5-flash-image
# Optional per-task overrides:
# MODEL_WRITER=anthropic/claude-sonnet-4.6
# MODEL_HOOK=anthropic/claude-sonnet-4.6
# MODEL_TOPIC=openai/gpt-4o
# MODEL_SCORING=openai/gpt-4o-mini
# MODEL_HASHTAG=openai/gpt-4o-mini
# MODEL_VISUAL=openai/gpt-4o-mini
# MODEL_CALENDAR=openai/gpt-4o-mini

# --- Gemini (embeddings ONLY) ---
# Used just for the RAG vector store now. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
