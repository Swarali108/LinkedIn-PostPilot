# Copy this file to .env.local and fill in your values.
# NEVER put real keys in this file — it is committed to git. Real secrets go in
# .env.local (which is gitignored).

# Public site URL — used as the auth base URL and in confirm/reset email links.
# Use http://localhost:3000 in .env.local for local dev.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Database (Neon Postgres + pgvector) ---
# Neon Console → your project → Connect → copy the POOLED connection string.
# Server-only. Required for accounts; without it brand memory falls back to disk.
# Run `npm run db:setup` once to create the tables. See NEON_SETUP.md.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Auth (Better Auth) ---
# Random secret that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=your_random_32_byte_secret

# --- Email (Resend) for signup confirmation + password reset ---
# https://resend.com/api-keys. Leave blank in dev: emails are printed to the
# server console instead. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=PostPilot <noreply@yourdomain.com>

# --- OpenRouter (text generation) ---
# One key, many models. Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key
# Cheap defaults to keep spend low; override per task with MODEL_* vars.
# IDs: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_CHEAP=google/gemini-2.5-flash-lite
# Image model for the auto-generated post infographic (fast + cheap default;
# use google/gemini-3-pro-image for max quality but ~45s latency).
MODEL_IMAGE=google/gemini-2.5-flash-image
# Optional per-task overrides:
# MODEL_WRITER=anthropic/claude-sonnet-4.6
# MODEL_HOOK=anthropic/claude-sonnet-4.6
# MODEL_TOPIC=openai/gpt-4o
# MODEL_SCORING=openai/gpt-4o-mini
# MODEL_HASHTAG=openai/gpt-4o-mini
# MODEL_VISUAL=openai/gpt-4o-mini
# MODEL_CALENDAR=openai/gpt-4o-mini

# --- Gemini (embeddings ONLY) ---
# Used just for the RAG vector store now. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
